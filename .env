# Base de datos
DB_HOST=db
DB_PORT=3306
DB_NAME=invests
DB_USER=appuser
DB_PASSWORD=apppass
MYSQL_ROOT_PASSWORD=root

# JWT
JWT_SECRET=change-this-in-production
JWT_REFRESH_SECRET=change-this-too
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Scheduler
AUTO_SNAPSHOT_ENABLED=true
AUTO_SNAPSHOT_TICK_MS=60000
FX_CACHE_TTL_MS=300000

# Push notifications (generar con: docker compose exec backend node scripts/generate-vapid-keys.js)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@invests.local
